# SIMURA environment — copy to .env and fill in. NEVER commit real keys.

# mock = deterministic scripted minds (free, for dev/tests). real = live LLM calls via Vercel AI SDK.
LLM_MODE=mock

# --- Global mind config (used by both founders unless overridden per-Kin) ---
# PROVIDER: azure | openai-compatible
PROVIDER=azure
LLM_API_KEY=your-key-here
MODEL=gpt-4o-mini

# azure provider:
AZURE_RESOURCE_NAME=your-resource-name
# AI SDK uses Azure's v1 endpoint — use 'preview' (dated versions are rejected)
AZURE_API_VERSION=preview

# openai-compatible provider (OpenAI, Ollama, vLLM, OpenRouter, …):
# API_BASE=https://api.openai.com/v1

# --- Optional per-Kin overrides (different models = free personality divergence) ---
# SOL_PROVIDER=azure
# SOL_LLM_API_KEY=...
# SOL_MODEL=gpt-5.4-mini-global
# LUNE_PROVIDER=openai-compatible
# LUNE_API_BASE=http://localhost:11434/v1
# LUNE_MODEL=llama3.3

# --- Server ---
PORT=8787
DB_PATH=data/simura.db
# World tick interval in ms (60000 = 1 think-tick per minute per Kin)
TICK_MS=60000

# --- Semantic memory embeddings (optional) ---
# Default: built-in local hashed embeddings (free, offline, no setup).
# To upgrade to a real embedding model, point at any OpenAI-compatible /embeddings endpoint:
# EMBED_API_BASE=https://your-resource.openai.azure.com/openai/v1
# EMBED_API_KEY=...
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=1536

# --- Discord herald (optional) ---
# Major world events (eras, births, deaths, bonds, prayers, firsts) posted as rich embeds.
# Create: Discord server → channel settings → Integrations → Webhooks → New Webhook → copy URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- Security (REQUIRED before exposing publicly) ---
# God endpoints (pace, dawn, expand, answers) require this header token when set:
# GOD_TOKEN=choose-a-long-random-string

# --- Terminal fallback: a local Ollama model as the last rung (world thinks even offline) ---
# MODEL_FALLBACKS=deepseek-v4-flash-free,http://localhost:11434/v1>>llama3.2
