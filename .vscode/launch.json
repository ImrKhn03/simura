{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SIMURA server (real + Discord)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "src/server/index.ts"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/config/local.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "SIMURA web (vite)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:web"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
